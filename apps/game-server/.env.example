REDIS_URL=redis://localhost:6379/1
DATABASE_URL=postgres://root:000000@localhost:5432/gaming_pool
PORT=5000
# Advertised WebSocket address — must match the api's GAME_SERVER_ADDR for this
# server (used by the boot sweep to recognize its own rooms in Redis).
GAME_SERVER_ADDR=ws://localhost:5000
# Must exactly match the API value; signs short-lived direct-connect tokens.
GAME_AUTH_SECRET=dev-only-game-auth-secret-change-me
